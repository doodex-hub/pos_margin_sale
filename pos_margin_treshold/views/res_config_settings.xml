<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_pos_margin_treshold" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_margin_treshold</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <setting help="Warning price less than minimum sale price will blocking the transaction.">
                    <field name="blocking_transaction_pos"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
