<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale" model="ir.ui.view">
        <field name="name">view.order.form.inherit.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add invisible field for rental check -->
            <xpath expr="//sheet" position="before">
                <field name="is_rental_order_installed_true" invisible="1"/>
            </xpath>
            
            <!-- Add decoration to price_unit -->
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="decoration-danger">minimum_sale_price &gt; price_unit and not parent.is_rental_order_installed_true</attribute>
            </xpath>

            <!-- Add minimum price fields as invisible fields -->
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="minimum_sale_price" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>