<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_sale_margin_action" model="res.groups">
        <field name="name">Sale Margin Action</field>
        <!-- base.module_category_hidden is an ir.module.category, not a res.groups: (4, ref(...)) used
             its id as a group id and made this group imply a built-in administrator group, so every
             member (the hook below adds all internal users) gained admin rights. Clear the relation
             on install and upgrade. -->
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>
</odoo>