# Ad-hoc Dockerfile for visual UI comparison of Odoo 20.0 vs 19.0.
# There is NO official odoo:20.0 image on Docker Hub yet (confirmed 2026-09-22 via
# `docker manifest inspect odoo:20.0` failing) so this runs Odoo 20.0 FROM SOURCE,
# bind-mounted at runtime from D:\Kuncoro\doodex\repo\odoo20 (Community) and
# D:\Kuncoro\doodex\repo\enterprise20 (Enterprise) -- NOT copied into the image, to
# keep the image build fast and avoid duplicating already-huge source checkouts.
#
# Python 3.12 chosen because odoo20/requirements.txt pins most packages to
# `python_version >= '3.12'` (Ubuntu 24.04 Noble / Debian 12 "Trixie"-track deps).
FROM python:3.12-slim-bookworm

# System packages needed to run Odoo from source + build wheels for packages that
# don't ship prebuilt wheels for this base image (gevent, psycopg2, lxml, ldap, etc).
# wkhtmltopdf intentionally skipped -- not needed for a UI smoke/visual-comparison
# test (PDF report rendering only), and it's a slow multi-hundred-MB install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libpq-dev \
    libffi-dev \
    postgresql-client \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    fonts-font-awesome \
    fonts-roboto-unhinted \
    gsfonts \
    node-less \
    npm \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# rtlcss is used by Odoo's asset bundler for RTL language stylesheets. Not needed
# for this English-only visual comparison (no RTL language installed), so it is
# skipped to keep the build fast -- revisit only if asset bundling errors on it.

# Install Python deps from the odoo20 checkout's requirements.txt (bind-mounted
# at build time via the compose build context, see docker-compose.20.yml).
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# MF-40/Step 9 (2026-09-22): headless Chrome + websocket-client, same pattern as the 19.0
# Dockerfile (see Dockerfile, "Mode D: real Chrome tour test") -- needed for Odoo's own
# HttpCase-based Tour tests (--test-tags) to actually run instead of skipping with "Chrome
# executable not found". Not needed for the plain visual-comparison use case this file was
# originally written for, but IS needed for Step 9 Dev Testing. Uses curl (already installed
# above) + gnupg instead of wget (not in the base apt list) for the repo signing key.
RUN apt-get update && apt-get install -y --no-install-recommends gnupg \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir websocket-client

# Non-root user matching the pattern of the 19.0 image (odoo user), source itself
# is bind-mounted read-only at runtime, not copied here.
RUN useradd -m -d /home/odoo -s /bin/bash odoo
RUN mkdir -p /var/log/odoo && chown odoo:odoo /var/log/odoo

USER odoo
