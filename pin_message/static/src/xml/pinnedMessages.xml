<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<!-- Pinned Messages Section -->
    <t t-name="mail.Chatter" t-inherit="mail.Chatter"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]" position="after">
            <!-- 20.0: bare identifiers (pinnedMessages, state, togglePinnedMessages) no longer
                 auto resolve to this.xxx in xpath inserted (t-inherit-mode="extension") nodes;
                 compiled output was ctx['pinnedMessages'] (plain context lookup, undefined)
                 instead of ctx['this'].pinnedMessages (MF-33). Native 20.0 templates always write
                 this. explicitly (see chatter.xml this.state...), matched here. -->
            <div t-if="this.pinnedMessages.length > 0" class="o-mail-PinnedMessages">
                <div class="d-flex pt-4 cursor-pointer fw-bolder"
                     t-on-click="this.togglePinnedMessages">
                    <hr class="flex-grow-1 fs-3"/>
                    <div class="d-flex align-items-center px-3">
                        <!-- 20.0 (DIFF-04): FontAwesome dihapus total dari template mail, diganti
                             Odoo Icons, pola persis native chatter.xml (this.state.showActivities
                             caret): oi/data-icon, arrow_drop_down/arrow_right. -->
                        <i class="oi oi-fw"
                           t-att-data-icon="this.state.showPinnedMessages ? 'arrow_drop_down' : 'arrow_right'"/>
                        Pinned Messages
                        <span t-if="!this.state.showPinnedMessages"
                              class="badge rounded-pill ms-2 text-bg-primary">
                            <t t-esc="this.pinnedMessages.length"/>
                        </span>
                    </div>
                    <hr class="flex-grow-1 fe-3"/>
                </div>
                <t t-if="this.state.showPinnedMessages">
                    <MessageCardList
                            messages="this.pinnedMessages"
                            thread="this.state.thread"
                            mode="'extended'"
                            showEmpty="false"/>
                </t>
            </div>
        </xpath>
    </t>
    <!-- Add Pin Button to Message -->
    <t t-name="mail.Message" t-inherit="mail.Message"
       t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o-mail-Message-author')]"
               position="after">
            <!-- 20.0 (MF-33, same root cause as mail.Chatter above): bare props also does not
                 auto resolve to this.props here, prefixed explicitly. -->
            <t t-if="this.props.message.message_type !== 'notification' and this.props.message.message_type !== 'auto_comment' and this.props.message.message_type !== 'user_notification' and !this.props.message.is_discussion and this.props.message.thread?.model !== 'mail.activity.thread'">
                <button class="btn btn-link"
                        t-on-click="() => this.onMessagePin(this.props.message.id)">
                    <!-- 20.0 (DIFF-04): FontAwesome dihapus total dari template mail,
                         "push_pin" dikonfirmasi nama ikon resmi (dipakai native sendiri,
                         message_model.js get notificationIcon() case "pin"), tinted text-primary/
                         text-muted sama seperti sebelumnya untuk state pinned/unpinned. -->
                    <i t-attf-class="oi {{ this.props.message.is_pinned ? 'text-primary' : 'text-muted' }}"
                       data-icon="push_pin"
                       role="img"
                       t-att-aria-label="this.props.message.is_pinned ? 'Unpin Message' : 'Pin Message'"/>
                </button>
            </t>
        </xpath>
    </t>
</templates>