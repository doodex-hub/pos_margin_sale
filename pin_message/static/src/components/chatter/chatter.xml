<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_Chatter_scrollPanel')]/t[1]" position="before">
            <t t-if="chatter.pinnedMessagesView">
                <PinnedMessages
                    className="'o_Chatter_pinnedMessages'"
                    record="chatter.pinnedMessagesView"
                />
            </t>
        </xpath>
    </t>
</templates>