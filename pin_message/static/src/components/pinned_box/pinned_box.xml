<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pin_message.PinnedBox" owl="1">
        <div class="o_PinnedBox d-flex py-2 px-3 border-bottom" t-attf-class="{{ className }}" t-ref="root">
            <div class="o_PinnedBox_sidebar me-3">
                <div class="o_PinnedBox_user position-relative h-100 w-100">
                    <t t-if="pinnedBoxView.message.author">
                        <img class="o_PinnedBox_userAvatar rounded-circle h-100 w-100 o_object_fit_cover" 
                             t-att-src="pinnedBoxView.avatarUrl"
                             t-att-alt="pinnedBoxView.message.author.nameOrDisplayName"/>
                    </t>
                </div>
            </div>
            <div class="o_PinnedBox_core flex-grow-1">
                <div class="o_PinnedBox_info d-flex align-items-baseline">
                    <t t-if="pinnedBoxView.message.author">
                        <b class="o_PinnedBox_author text-900 me-2">
                            <t t-esc="pinnedBoxView.message.author.nameOrDisplayName"/>
                        </b>
                    </t>
                    <button
                        class="o_PinnedBox_unpinButton btn py-0 ms-auto"
                        t-on-click="pinnedBoxView.onClickUnpin"
                        title="Unpin message"
                        aria-label="Unpin message"
                    >
                        <i class="fa fa-times" role="img"/>
                    </button>
                </div>

                <div class="o_PinnedBox_content mt-2">
                    <t t-out="pinnedBoxView.message.prettyBodyAsMarkup"/>
                </div>
            </div>
        </div>
    </t>

</templates>
